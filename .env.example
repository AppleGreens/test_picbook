NANO_BANANA_API_KEY=your_api_key_here

# Optional overrides
NANO_BANANA_BASE_URL=https://api.grsai.com
NANO_BANANA_MODEL=nano-banana-pro
NANO_BANANA_ASPECT_RATIO=16:9
NANO_BANANA_IMAGE_SIZE=2k
NANO_BANANA_MAX_WAIT_SECONDS=120
NANO_BANANA_POLL_INTERVAL_SECONDS=5
NANO_BANANA_REQUEST_TIMEOUT_SECONDS=30
NANO_BANANA_REFERENCE_IMAGE_FIELD=imageUrls

# MinerU document parsing / OCR
MINERU_API_KEY=your_mineru_api_key_here
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_MAX_WAIT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_REQUEST_TIMEOUT_SECONDS=30
MINERU_UPLOAD_TIMEOUT_SECONDS=180
MINERU_UPLOAD_RETRIES=3
